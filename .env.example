# Database credentials (used by docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=revenue_ops

# Connection string for Python scripts (local development)
# For local development against Docker:
DB_CONNECTION_STRING=postgresql://admin:your_secure_password_here@localhost:5432/revenue_ops

# For connecting from within Docker network (used by dashboard container):
# DB_CONNECTION_STRING=postgresql://admin:your_secure_password_here@postgres:5432/revenue_ops

# NAS IP for Power BI connection (replace with your NAS IP):
# Server: 192.168.x.x
# Port: 5432
# Database: revenue_ops
# User: admin
# Password: your_secure_password_here
